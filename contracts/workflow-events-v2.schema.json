{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opspilot:workflow-events:2",
  "title": "S03 closed audit events v2 — installed by migration 0002",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "stream_id",
    "seq",
    "event_type",
    "occurred_at",
    "actor_id",
    "trace_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": 2
    },
    "stream_id": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "enum": [
        "incident.created",
        "workflow.transitioned",
        "workflow.cancel_requested",
        "workflow.blocked"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$(?![\\s\\S])"
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$(?![\\s\\S])"
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "created": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "aggregate_id",
        "aggregate_version",
        "evidence_ids"
      ],
      "properties": {
        "reason_code": {
          "const": "INTAKE_ACCEPTED"
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_version": {
          "const": 1
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "transitioned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "aggregate_id",
        "aggregate_version",
        "evidence_ids",
        "transition",
        "snapshot_hash"
      ],
      "properties": {
        "reason_code": {
          "enum": [
            "LOCAL_STEP_STARTED",
            "LOCAL_SNAPSHOT_RECORDED",
            "TRANSIENT_LOCAL_FAILURE",
            "RETRY_READY",
            "DEADLINE_EXHAUSTED",
            "RETRY_EXHAUSTED",
            "PERMANENT_LOCAL_FAILURE",
            "CANCELLED_BY_OPERATOR"
          ]
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9223372036854775807
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "definition_version"
          ],
          "properties": {
            "from": {
              "enum": [
                "QUEUED",
                "INVESTIGATING",
                "PLAN_READY",
                "AWAITING_APPROVAL",
                "EXECUTING",
                "VERIFYING",
                "RETRY_WAIT",
                "OUTCOME_UNKNOWN",
                "NEEDS_OPERATOR",
                "SUCCEEDED",
                "FAILED",
                "CANCELLED"
              ]
            },
            "to": {
              "enum": [
                "QUEUED",
                "INVESTIGATING",
                "PLAN_READY",
                "AWAITING_APPROVAL",
                "EXECUTING",
                "VERIFYING",
                "RETRY_WAIT",
                "OUTCOME_UNKNOWN",
                "NEEDS_OPERATOR",
                "SUCCEEDED",
                "FAILED",
                "CANCELLED"
              ]
            },
            "definition_version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "reason_code": {
              "const": "LOCAL_STEP_STARTED"
            },
            "transition": {
              "properties": {
                "from": {
                  "const": "QUEUED"
                },
                "to": {
                  "const": "INVESTIGATING"
                }
              }
            }
          }
        },
        {
          "properties": {
            "reason_code": {
              "const": "LOCAL_SNAPSHOT_RECORDED"
            },
            "evidence_ids": {
              "minItems": 1
            },
            "transition": {
              "properties": {
                "from": {
                  "const": "INVESTIGATING"
                },
                "to": {
                  "const": "NEEDS_OPERATOR"
                }
              }
            }
          }
        },
        {
          "properties": {
            "reason_code": {
              "const": "TRANSIENT_LOCAL_FAILURE"
            },
            "transition": {
              "properties": {
                "from": {
                  "const": "INVESTIGATING"
                },
                "to": {
                  "const": "RETRY_WAIT"
                }
              }
            }
          }
        },
        {
          "properties": {
            "reason_code": {
              "const": "RETRY_READY"
            },
            "transition": {
              "properties": {
                "from": {
                  "const": "RETRY_WAIT"
                },
                "to": {
                  "const": "INVESTIGATING"
                }
              }
            }
          }
        },
        {
          "properties": {
            "reason_code": {
              "const": "DEADLINE_EXHAUSTED"
            },
            "transition": {
              "properties": {
                "from": {
                  "const": "QUEUED"
                },
                "to": {
                  "const": "FAILED"
                }
              }
            }
          }
        },
        {
          "properties": {
            "reason_code": {
              "const": "DEADLINE_EXHAUSTED"
            },
            "transition": {
              "properties": {
                "from": {
                  "enum": [
                    "INVESTIGATING",
                    "RETRY_WAIT"
                  ]
                },
                "to": {
                  "const": "NEEDS_OPERATOR"
                }
              }
            }
          }
        },
        {
          "properties": {
            "reason_code": {
              "enum": [
                "RETRY_EXHAUSTED",
                "PERMANENT_LOCAL_FAILURE"
              ]
            },
            "transition": {
              "properties": {
                "from": {
                  "const": "INVESTIGATING"
                },
                "to": {
                  "const": "NEEDS_OPERATOR"
                }
              }
            }
          }
        },
        {
          "properties": {
            "reason_code": {
              "const": "CANCELLED_BY_OPERATOR"
            },
            "transition": {
              "properties": {
                "from": {
                  "enum": [
                    "QUEUED",
                    "INVESTIGATING",
                    "PLAN_READY",
                    "AWAITING_APPROVAL",
                    "RETRY_WAIT",
                    "NEEDS_OPERATOR"
                  ]
                },
                "to": {
                  "const": "CANCELLED"
                }
              }
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "reason_code": {
                "not": {
                  "const": "CANCELLED_BY_OPERATOR"
                }
              }
            }
          },
          "then": {
            "properties": {
              "transition": {
                "properties": {
                  "definition_version": {
                    "const": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason_code": {
                "not": {
                  "const": "LOCAL_SNAPSHOT_RECORDED"
                }
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "cancelRequested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "aggregate_id",
        "aggregate_version",
        "evidence_ids",
        "snapshot_hash"
      ],
      "properties": {
        "reason_code": {
          "const": "CANCEL_REQUESTED"
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9223372036854775807
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 0
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      }
    },
    "blocked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "aggregate_id",
        "aggregate_version",
        "evidence_ids",
        "snapshot_hash"
      ],
      "properties": {
        "reason_code": {
          "const": "UNSUPPORTED_DEFINITION"
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9223372036854775807
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 0
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "workflow.transitioned"
          },
          "payload": {
            "properties": {
              "reason_code": {
                "const": "CANCELLED_BY_OPERATOR"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "actor_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "workflow.transitioned"
          },
          "payload": {
            "properties": {
              "reason_code": {
                "not": {
                  "const": "CANCELLED_BY_OPERATOR"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "actor_id": {
            "type": "null"
          }
        }
      }
    }
  ],
  "oneOf": [
    {
      "properties": {
        "event_type": {
          "const": "incident.created"
        },
        "actor_id": {
          "type": "string",
          "format": "uuid"
        },
        "payload": {
          "$ref": "#/$defs/created"
        }
      }
    },
    {
      "properties": {
        "event_type": {
          "const": "workflow.transitioned"
        },
        "payload": {
          "$ref": "#/$defs/transitioned"
        }
      }
    },
    {
      "properties": {
        "event_type": {
          "const": "workflow.cancel_requested"
        },
        "actor_id": {
          "type": "string",
          "format": "uuid"
        },
        "payload": {
          "$ref": "#/$defs/cancelRequested"
        }
      }
    },
    {
      "properties": {
        "event_type": {
          "const": "workflow.blocked"
        },
        "actor_id": {
          "type": "null"
        },
        "payload": {
          "$ref": "#/$defs/blocked"
        }
      }
    }
  ]
}
