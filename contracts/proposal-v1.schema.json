{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opspilot:proposal:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "plan_version", "tool_id", "tool_version", "resource_id", "policy_version", "expires_at", "arguments", "evidence_ids"],
  "properties": {
    "workflow_id": {"type": "string", "format": "uuid"},
    "plan_version": {"type": "integer", "minimum": 1},
    "tool_id": {"enum": ["vpn.service_status", "vpn.restart_service", "vpn.client_probe"]},
    "tool_version": {"const": 1},
    "resource_id": {"const": "lab-vpn-01"},
    "policy_version": {"type": "integer", "minimum": 1},
    "expires_at": {"type": "string", "format": "date-time"},
    "arguments": {"type": "object", "additionalProperties": false, "properties": {}},
    "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}
  }
}
