# Mandatory. Supply your own credential file; no secrets are included here.
OPSPILOT_ENVIRONMENT=lab
OPSPILOT_DATABASE_DSN_FILE=artifacts/local/app.dsn
OPSPILOT_OIDC_ISSUER=http://127.0.0.1:59080/realms/opspilot
OPSPILOT_OIDC_AUDIENCE=opspilot-api
OPSPILOT_OIDC_JWKS_URL=http://127.0.0.1:59080/realms/opspilot/protocol/openid-connect/certs
# Optional bounded settings: JWKS_TTL_SECONDS=300, JWKS_REFRESH_SECONDS=30,
# HTTP_TIMEOUT_SECONDS=2, DB_TIMEOUT_MS=1000 (all with OPSPILOT_ prefix).
# Production requires HTTPS OIDC and sslmode=verify-full. Compose is lab-only.
